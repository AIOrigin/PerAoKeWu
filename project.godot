[internationalization]

locale/translation_remaps={}
locale/translations=PackedStringArray()

[layer_names]

3d_render/layer_1="所有"
3d_render/layer_2="云"
3d_render/layer_3="远景"
3d_physics/layer_1="Environment"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Projectiles"
3d_physics/layer_5="PhysicsObjects"
3d_physics/layer_6="Liquid"
3d_physics/layer_7="Interaction"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_angular_velocity=17.4533
3d/sleep_threshold_linear=0.2
3d/sleep_threshold_angular=0.20944
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
reflections/sky_reflections/fast_filter_high_quality=true
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
textures/decals/filter=4
textures/light_projectors/filter=4
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
