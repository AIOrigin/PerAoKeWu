; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="HYPERLUNATIC"
config/version="v0.1.0-dev.2"
config/tags=PackedStringArray("master")
run/main_scene="res://assets/maps/route_levels/mobile_home/mobile_home.tscn"
config/features=PackedStringArray("4.6", "Forward Plus", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cyvwaefw3t2aa"

[autoload]

FreezeTickManager="*res://assets/global/scripts/FreezeTickManager.gd"
Global="*res://assets/global/global.tscn"

[debug]

settings/physics_interpolation/enable_warnings=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="HYPERLUNATIC"

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/namespace_linker/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://SimpleFPSController-main/": "gray",
"res://assets/": "blue",
"res://assets/arts_graphic/": "green",
"res://assets/arts_graphic/icon/": "green",
"res://assets/arts_graphic/materials/": "green",
"res://assets/arts_graphic/resources/": "green",
"res://assets/arts_graphic/shaders/": "green",
"res://assets/arts_graphic/textures/": "green",
"res://assets/arts_graphic/themes/": "green",
"res://assets/arts_graphic/ui/": "green",
"res://assets/audio/": "orange",
"res://assets/enemy/": "red",
"res://assets/maps/": "yellow",
"res://assets/models/": "green",
"res://assets/special_effects/": "green",
"res://assets/weapons/": "teal",
"res://assets/weapons/scripts/": "purple",
"res://assets/weapons/sounds/": "purple",
"res://assets/weapons/textures/": "purple",
"res://example/": "gray",
"res://test_scenario/": "gray",
"res://导出/": "gray",
"res://文档/": "gray"
}

[filesystem]

import/blender/enabled=false

[global_group]

Normal3DGameScene=""
Sign="告示牌一类"
Probe="探针"
BeStandBody=""
danmaku="弹幕"

[gui]

theme/custom_font="uid://ch7c66fibecsi"

[importer_defaults]

3d_texture={
"compress/mode": 3
}
texture={
"compress/mode": 3
}
2d_array_texture={
"compress/mode": 3
}

